# Copy to infra/.env and fill in
# infra/.env is gitignored
# Secrets: every *_PASSWORD and *_KEY variable
# They reach containers only as Compose secrets (/run/secrets/<name>).

## Postgres (PostGIS)
# Names and passwords below are applied only when the postgres data volume
# is first created. Changing them later requires recreating the volume.

# Superuser, used only inside the postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Gold database, and its owner role (used by dbt)
TERRAPLANTARUM_DB_NAME=terraplantarum
TERRAPLANTARUM_DB_ROLE=terraplantarum
TERRAPLANTARUM_DB_PASSWORD=

# Read-only role for the API on the gold database
TERRAPLANTARUM_API_DB_ROLE=terraplantarum_api
TERRAPLANTARUM_API_DB_PASSWORD=

# Dagster run-history database, and its owner role
DAGSTER_DB_NAME=dagster
DAGSTER_DB_ROLE=dagster
DAGSTER_DB_PASSWORD=

#Port for local tools, bound to 127.0.0.1 only; never reachable from other machines
POSTGRES_HOST_PORT=5432

## SeaweedFS (S3-compatible object store under lakeFS)
# Access key lakeFS uses to reach the store
SEAWEEDFS_S3_ACCESS_KEY=
# secret key paired with the access key above
SEAWEEDFS_S3_SECRET_KEY=
# Bucket that holds the lakeFS repositories; created on first start
SEAWEEDFS_LAKE_BUCKET=terraplantarum-lake
# Admin UI login (reached through Caddy)
SEAWEEDFS_ADMIN_USER=admin
SEAWEEDFS_ADMIN_PASSWORD=
# Internal signing keys: volume writes, filer writes, filer reads
SEAWEEDFS_JWT_SIGNING_KEY=
SEAWEEDFS_JWT_FILER_SIGNING_KEY=
SEAWEEDFS_JWT_FILER_SIGNING_READ_KEY=

## lakeFS
# Used to encrypt and sign lakeFS metadata
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=
# Initial admin user, created on first start only (like the Postgres names)
LAKEFS_ADMIN_USER=admin
LAKEFS_ADMIN_ACCESS_KEY=
LAKEFS_ADMIN_SECRET_KEY=
# Repository that holds bronze, silver and gold; dbt reaches it through the lakeFS S3 gateway
LAKEFS_REPOSITORY=terraplantarum

## Caddy
# Base domain for every site: localhost on a dev machine, the real domain in production
TERRAPLANTARUM_DOMAIN=localhost
